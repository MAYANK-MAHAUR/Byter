{
  "name": "@reprosmith/demo-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "demo": "node dist/cli.js",
    "lint": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@reprosmith/core": "workspace:*",
    "@reprosmith/repro-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
