{
  "name": "reprosmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "demo:e2e": "pnpm --filter @reprosmith/core build && pnpm --filter @reprosmith/repro-engine build && pnpm --filter @reprosmith/demo-runner build && pnpm --filter @reprosmith/demo-runner demo",
    "dev": "pnpm --filter @reprosmith/web dev",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
